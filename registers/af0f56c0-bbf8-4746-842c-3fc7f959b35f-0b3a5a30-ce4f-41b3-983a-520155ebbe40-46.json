      "new_value" : "CREATE OR REPLACE PACKAGE CMDKLTDA_LUIS_PCK AS\n\n    -- Retorna o nome do cliente\n    FUNCTION obter_nome_cliente(\n        p_id_cliente IN NUMBER\n    ) RETURN VARCHAR2;\n\nEND CMDKLTDA_LUIS_PCK;\n/CREATE OR REPLACE PACKAGE BODY CMDKLTDA_LUIS_PCK AS\n\n    FUNCTION obter_nome_cliente(\n        p_id_cliente IN NUMBER\n    ) RETURN VARCHAR2\n    IS\n        v  varchar2(100);\n        n number(20);\n    BEGIN\n        SELECT 'teste'\n          INTO v\n          FROM cliente_tasy\n         WHERE 1= p_id_cliente;\n         \n        --select max(user_id) into v from AE_LOGIN;\n\n\t\t--CMDKLTD_EXECUCAO_PRESCRICAO_PCK.limpar_w_execucao_proc_mat(1,1,1,1,'cmdk-adm');\n\n\t\tselect OBTER_DT_ENTREGA_MD ('','',1,sysdate,1) into n from dual;\n\n        RETURN 'teste';\n\n    END obter_nome_cliente;\n\nEND CMDKLTDA_LUIS_PCK;\n/",
